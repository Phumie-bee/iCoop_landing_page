# Copy this file to `.env.local` and fill in the values.
# On Vercel, add the same variables under Project Settings → Environment Variables.

# Neon Postgres connection string (server-only — never NEXT_PUBLIC). https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend API key for transactional email (server-only). https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The From address on every outgoing email. The domain must be verified in
# Resend, otherwise mail is rejected or lands in spam.
EMAIL_FROM=iCoop <noreply@icoop.ng>

# Password for HTTP Basic auth on /admin (username is always "admin").
ADMIN_PASSWORD=choose-a-long-random-password

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
# Without it the reminder endpoint would be publicly triggerable.
CRON_SECRET=another-long-random-string

# Optional — a short teaser video linked in the 24-hour reminder email.
TEASER_VIDEO_URL=

# Production origin — used to build absolute links inside emails.
SITE_URL=https://icoop.ng
